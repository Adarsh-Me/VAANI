# Gradle / Android / IDE
.gradle/
build/
local.properties
.idea/
*.iml
.DS_Store
captures/
.externalNativeBuild/
.cxx/

# Signing material (never commit)
*.jks
*.keystore
key.properties

# Room schema exports are build artifacts of record — keep them.
!app/schemas/

# Downloaded models (hundreds of MB, fetched at runtime)
*.onnx
*.onnx.data
*.ort
*.wav
*.msi
*.zip
*.tar.bz2

# Submission docs excluded per project owner
Docs/
README.md

# Local diagnostics & staged model artifacts (machine-only)
tools/
.toolchain-tmp/

# Python
__pycache__/

# Local screenshots / UI dumps
shot*.png
tapfb.png
ui_now.xml
lat.xml

# HF token (SraVaani gated access)
.hf_token

MODEL_STACK.md

# Flite engine source (local native-build vendor; re-clone per tools/gen_cmake2.py)
tools/flite-src/
tools/flite-android/flite-src
# keep the flite build recipe in git (reconstructs fully from public repos)
!tools/flite-android/CMakeLists.txt
!tools/flite-android/itantra_flite_jni.cc
# .cxx build cache
app/.cxx/
app/.cxx.bak-flite/
# bundled model assets are build artifacts (seeded from tooling, not source)
app/src/main/assets/savaani/
app/src/main/assets/flite/
